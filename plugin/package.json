{
  "name": "dsh-plugin-cds",
  "version": "0.1.1",
  "description": "Claude Design System theme for DeepSeek Harness: overrides 11 host design tokens (light + dark), ships the CDS scale and motion physics. No fonts, no network requests.",
  "icon": "./icon.png",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztc1522021381/dsh-plugin-cds.git"
  },
  "homepage": "https://github.com/ztc1522021381/dsh-plugin-cds#readme",
  "bugs": {
    "url": "https://github.com/ztc1522021381/dsh-plugin-cds/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./theme.css": "./dist/cds-theme.css",
    "./motion": "./dist/cds-motion.mjs",
    "./tokens": "./dist/cds-tokens.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/client/index.d.ts",
    "types/index.d.ts",
    "dist/cds-theme.css",
    "dist/cds-motion.mjs",
    "dist/cds-tokens.json",
    "cordis.patch.yml",
    "icon.png",
    "locale/en.json",
    "locale/zh.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "theme",
    "design-system",
    "claude",
    "css-tokens"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  }
}
