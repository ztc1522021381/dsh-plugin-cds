{
  "name": "dsh-plugin-cds",
  "version": "0.1.0",
  "description": "Claude Design System (open-claude-ui) theme layer for DeepSeek Harness: CDS tokens + host aliases + motion physics",
  "icon": "./icon.png",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./theme.css": "./dist/cds-theme.css",
    "./motion": "./dist/cds-motion.mjs",
    "./tokens": "./dist/cds-tokens.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/client/index.d.ts",
    "types/index.d.ts",
    "dist/cds-theme.css",
    "dist/cds-motion.mjs",
    "dist/cds-tokens.json",
    "cordis.patch.yml",
    "icon.png",
    "locale/en.json",
    "locale/zh.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  }
}
